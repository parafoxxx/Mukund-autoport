# Copy to .env.local for local dev; add the same names in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Optional: Mukund's cloned voice (ElevenLabs). Without these, replies use the browser's voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional overrides
# CHAT_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2   (speech-to-text, used for voice driving in browsers like Brave)
# Speech-to-text for voice driving (recommended: Sarvam AI, best with Hinglish). Without it, the browser's own recognition is used.
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_LANGUAGE=en-IN   (or "unknown" to auto-detect, which may return Devanagari)
