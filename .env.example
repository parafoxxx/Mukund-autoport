# Copy to .env.local for local dev; add the same names in Netlify > Site configuration > Environment variables.
# Speech-to-text for voice driving (recommended: Sarvam AI, best with Hinglish). Without it, the browser's own recognition is used.
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_LANGUAGE=en-IN   (or "unknown" to auto-detect, which may return Devanagari)
# Optional fallback: ElevenLabs Scribe
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
